# Konfigurasi khusus automated test (npm test).
# Opsional: salin menjadi .env.test lalu isi dengan nilai sendiri.
# Jika .env.test tidak ada, tests/setup.js memakai nilai default khusus test.
# JANGAN isi dengan kredensial production.
NODE_ENV=test
JWT_SECRET=isi_dengan_secret_khusus_test
JWT_EXPIRES_IN=1d
EXTERNAL_API_KEY=isi_dengan_api_key_khusus_test
ADMIN_SECRET_KEY=isi_dengan_admin_key_khusus_test
